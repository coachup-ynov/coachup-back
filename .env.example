# Copier ce fichier en .env puis adapter les valeurs
ENVIRONMENT=local
PROJECT_NAME=CoachUp API

# Base de données
POSTGRES_HOST=localhost
# Mettre 5433 si un Postgres tourne déjà en local sur 5432
POSTGRES_PORT=5432
POSTGRES_USER=coachup
POSTGRES_PASSWORD=coachup
POSTGRES_DB=coachup

# Sécurité (générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=change-me

# CORS : origines autorisées (front Angular)
CORS_ORIGINS=["http://localhost:4200"]

# Emails (Mailpit en local : UI sur http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=no-reply@coachup.local
